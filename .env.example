# ============================================================
# Asif-YouTube-Agent — settings file
# HOW TO USE: copy this file and name the copy ".env"
# (on Windows: copy .env.example, rename the copy to .env)
# Then fill in the keys you have. Lines starting with # are comments.
# ============================================================

# --- Your YouTube channel ---
# Default is the "Asif Ahmad Food Tech" channel from the specification.
# To point at the Everyday Food Science channel instead, use:
#   CHANNEL_ID=UCYR1I8umpYZ4-Xg7t0BEItw
#   CHANNEL_NAME=Everyday Food Science
#   CHANNEL_URL=https://www.youtube.com/channel/UCYR1I8umpYZ4-Xg7t0BEItw
CHANNEL_ID=UCjFTXuF1LhQdKsktFxPRKSw
CHANNEL_NAME=Asif Ahmad Food Tech
CHANNEL_URL=https://www.youtube.com/c/AsifAhmadfoodtech

# --- Which AI writes the scripts? Pick ONE: gemini, openai, anthropic, openrouter, ollama ---
# gemini is recommended to start: it is free and easy (see SETUP-GUIDE.md step 4).
LLM_PROVIDER=gemini

# Gemini key — free at https://aistudio.google.com (click "Get API key").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI key — from https://platform.openai.com/api-keys (paid).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) key — from https://console.anthropic.com (paid).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenRouter key — from https://openrouter.ai/keys (many models, some free).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (runs on your own computer, no key) — install from https://ollama.com
# then run "ollama pull llama3.1" once in a terminal.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- YouTube API key (for the Research menu) ---
# From Google Cloud Console, same project as credentials.json (SETUP-GUIDE.md step 3).
YOUTUBE_API_KEY=

# --- Voice ---
# Free Microsoft Edge voice. Other examples: en-US-GuyNeural, en-GB-RyanNeural,
# en-IN-PrabhatNeural. Full list: the agent can show voices, or see
# https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support?tabs=tts
TTS_VOICE=en-US-ChristopherNeural

# --- Uploading ---
# privacy: private (only you can see it — safest), unlisted (anyone with the link), public
UPLOAD_PRIVACY=private
# Playlist ID to add uploads to (optional — leave empty for no playlist).
# Find it in the playlist URL: youtube.com/playlist?list=PLxxxxxxxx
PLAYLIST_ID=
# Video language code (en = English).
VIDEO_LANGUAGE=en
